{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opc-finance.local/schemas/box-service-request.schema.json",
  "title": "OPC Finance Box service request",
  "type": "object",
  "required": ["service_id", "payload"],
  "properties": {
    "service_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "payload": {"type": "object"},
    "entity_id": {"type": "string", "minLength": 1},
    "entity_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "approval": {
      "type": "object",
      "required": ["gate", "decision", "approved_by", "approved_at"],
      "properties": {
        "gate": {"type": "string", "minLength": 1},
        "decision": {"const": "approved"},
        "approved_by": {"type": "string", "minLength": 1},
        "approved_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {"not": {"required": ["entity_id", "entity_ids"]}}
  ],
  "additionalProperties": false
}
