{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opc-finance.local/schemas/box-config.schema.json",
  "title": "OPC Finance Box configuration",
  "type": "object",
  "required": [
    "box_version",
    "name",
    "core",
    "business_models",
    "channels",
    "connectors",
    "features",
    "entities"
  ],
  "properties": {
    "box_version": {"const": 1},
    "name": {"type": "string", "minLength": 1},
    "data_mode": {"enum": ["demo", "live"]},
    "reporting_currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "core": {"type": "string", "pattern": "^core\\."},
    "business_models": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^industry\\."}
    },
    "channels": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^channel\\."}
    },
    "connectors": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^connector\\."}
    },
    "connector_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["connector_pack", "entity_ids"],
        "properties": {
          "connector_pack": {"type": "string", "pattern": "^connector\\."},
          "entity_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"}
          }
        },
        "additionalProperties": false
      }
    },
    "features": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^feature\\."}
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "jurisdiction",
          "functional_currency",
          "accounting_basis",
          "fiscal_year_end",
          "tax_pack",
          "tax_registrations"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
          "name": {"type": "string", "minLength": 1},
          "jurisdiction": {"type": "string", "pattern": "^[A-Z]{2}(-[A-Z0-9]{1,3})?$"},
          "functional_currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
          "accounting_basis": {"type": "string", "minLength": 1},
          "fiscal_year_end": {
            "type": "string",
            "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
          },
          "tax_pack": {"type": "string", "pattern": "^jurisdiction\\."},
          "tax_registrations": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
