{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opc-finance.local/schemas/box-spec.schema.json",
  "title": "OPC Finance Box simplified product specification",
  "type": "object",
  "required": ["name", "entities"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "business_type": {"type": "string", "minLength": 1},
    "business_models": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "channels": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "integrations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "connectors": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "connector_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["connector_pack", "entity_ids"],
        "properties": {
          "connector_pack": {"type": "string", "minLength": 1},
          "entity_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"}
          }
        },
        "additionalProperties": false
      }
    },
    "features": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "data_mode": {"enum": ["demo", "live"]},
    "reporting_currency": {"type": "string", "pattern": "^[A-Za-z]{3}$"},
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entity"}
    }
  },
  "anyOf": [
    {"required": ["business_type"]},
    {"required": ["business_models"]}
  ],
  "additionalProperties": false,
  "$defs": {
    "entity": {
      "type": "object",
      "required": ["id", "name", "functional_currency", "accounting_basis"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "name": {"type": "string", "minLength": 1},
        "tax_country": {"type": "string", "pattern": "^[A-Za-z]{2}(-[A-Za-z0-9]{1,3})?$"},
        "jurisdiction": {"type": "string", "pattern": "^[A-Za-z]{2}(-[A-Za-z0-9]{1,3})?$"},
        "tax_pack": {"type": "string", "pattern": "^jurisdiction\\."},
        "functional_currency": {"type": "string", "pattern": "^[A-Za-z]{3}$"},
        "accounting_basis": {"type": "string", "minLength": 1},
        "fiscal_year_end": {
          "type": "string",
          "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
        },
        "tax_registrations": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      },
      "anyOf": [
        {"required": ["tax_country"]},
        {"required": ["jurisdiction"]},
        {"required": ["tax_pack"]}
      ],
      "additionalProperties": false
    }
  }
}
