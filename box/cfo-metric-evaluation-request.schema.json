{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opc-finance-box.local/schemas/cfo-metric-evaluation-request.schema.json",
  "title": "OPC Finance Box CFO Metric Evaluation Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runtime_fingerprint",
    "period",
    "currency"
  ],
  "properties": {
    "runtime_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "period": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "metric_type_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dimension_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension_type_id",
        "dimension_value_ids"
      ],
      "properties": {
        "dimension_type_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "dimension_value_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "operand_values": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/decimalOperand"
      }
    },
    "vector_operand_values": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/$defs/decimalOperand"
        }
      }
    },
    "confirmed_control_type_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "decimalOperand": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        }
      ]
    }
  }
}
