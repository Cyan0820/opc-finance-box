{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opc-finance.local/schemas/api-auth.schema.json",
  "title": "OPC Finance role-based API authentication policy",
  "type": "object",
  "required": ["schema_version", "principals"],
  "properties": {
    "schema_version": {"const": 1},
    "principals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["principal_id", "token_sha256", "roles"],
        "properties": {
          "principal_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.@-]{0,79}$"
          },
          "token_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["reader", "operator", "reviewer", "admin"]}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
