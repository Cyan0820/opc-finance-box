{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opc.finance/schemas/pilot-readiness-artifact.schema.json",
  "title": "OPC Finance Box first-company pilot readiness artifact",
  "description": "Private, Box-bound readiness workpaper and independent review for one bounded Shadow Close period.",
  "$comment": "Runtime validation additionally enforces exact current entities, exact industry-derived domains, exact selected network connectors, fingerprints, role separation and private 0600 storage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_type", "runtime_fingerprint", "plan_fingerprint",
    "period", "prepared_by", "operator_principal", "entities", "network_connectors",
    "shadow_close_plan", "contains_credentials", "contains_raw_source_identifiers",
    "contains_raw_tax_identifiers", "contains_financial_values",
    "external_actions_authorized", "template_only"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_type": {"enum": ["pilot_readiness_workpaper", "pilot_readiness_review"]},
    "runtime_fingerprint": {"$ref": "#/$defs/fingerprint"},
    "plan_fingerprint": {"$ref": "#/$defs/fingerprint"},
    "period": {"type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"},
    "prepared_by": {"$ref": "#/$defs/actor"},
    "operator_principal": {"$ref": "#/$defs/actor"},
    "entities": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["entity_id", "data_domains"],
        "properties": {
          "entity_id": {"type": "string", "minLength": 1, "maxLength": 80},
          "data_domains": {
            "type": "array", "minItems": 6, "maxItems": 20,
            "items": {"$ref": "#/$defs/data_domain"}
          }
        }
      }
    },
    "network_connectors": {
      "type": "array", "maxItems": 50,
      "items": {"$ref": "#/$defs/network_connector"}
    },
    "shadow_close_plan": {
      "type": "object", "additionalProperties": false,
      "required": ["planned", "period", "baseline_owner", "evidence_references"],
      "properties": {
        "planned": {"type": "boolean"},
        "period": {"type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"},
        "baseline_owner": {"$ref": "#/$defs/actor"},
        "evidence_references": {"$ref": "#/$defs/references"}
      }
    },
    "contains_credentials": {"const": false},
    "contains_raw_source_identifiers": {"const": false},
    "contains_raw_tax_identifiers": {"const": false},
    "contains_financial_values": {"const": false},
    "external_actions_authorized": {"const": false},
    "template_only": {"type": "boolean"},
    "review": {"$ref": "#/$defs/review"}
  },
  "allOf": [
    {
      "if": {"properties": {"artifact_type": {"const": "pilot_readiness_review"}}},
      "then": {"required": ["review"], "properties": {"template_only": {"const": false}}},
      "else": {"properties": {"template_only": {"const": true}}}
    }
  ],
  "$defs": {
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "actor": {"type": "string", "minLength": 2, "maxLength": 128},
    "references": {
      "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true,
      "items": {
        "type": "string", "maxLength": 212,
        "pattern": "^(evidence|document|workpaper|registry|advisor|authority)://"
      }
    },
    "data_domain": {
      "type": "object", "additionalProperties": false,
      "required": [
        "domain", "display_name", "required", "not_applicable_allowed", "status",
        "acquisition_mode", "mapped_entity_id", "period_coverage",
        "read_only_confirmed", "mapping_approved_by", "evidence_references"
      ],
      "properties": {
        "domain": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,79}$"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 120},
        "required": {"type": "boolean"},
        "not_applicable_allowed": {"type": "boolean"},
        "status": {"enum": ["pending", "ready", "not_applicable"]},
        "acquisition_mode": {"enum": ["pending", "file_export", "connector", "not_applicable"]},
        "mapped_entity_id": {"type": "string", "minLength": 1, "maxLength": 80},
        "period_coverage": {
          "type": "array", "maxItems": 24, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"}
        },
        "read_only_confirmed": {"type": "boolean"},
        "mapping_approved_by": {"$ref": "#/$defs/actor"},
        "evidence_references": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "network_connector": {
      "type": "object", "additionalProperties": false,
      "required": [
        "connector_id", "status", "entity_ids", "credential_reference_configured",
        "provider_contract_passed", "bounded_read_window_confirmed", "checkpoint_owner",
        "mapping_approved_by", "evidence_references"
      ],
      "properties": {
        "connector_id": {"type": "string", "minLength": 1, "maxLength": 120},
        "status": {"enum": ["pending", "ready", "approved_file_fallback"]},
        "entity_ids": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string"}},
        "credential_reference_configured": {"type": "boolean"},
        "provider_contract_passed": {"type": "boolean"},
        "bounded_read_window_confirmed": {"type": "boolean"},
        "checkpoint_owner": {"$ref": "#/$defs/actor"},
        "mapping_approved_by": {"$ref": "#/$defs/actor"},
        "evidence_references": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": [
        "decision", "actor", "rationale", "evidence_references", "reviewed_at",
        "review_due_at", "expires_at", "workpaper_fingerprint", "review_id"
      ],
      "properties": {
        "decision": {"const": "approved_for_bounded_shadow"},
        "actor": {"$ref": "#/$defs/actor"},
        "rationale": {"type": "string", "minLength": 12, "maxLength": 1000},
        "evidence_references": {"$ref": "#/$defs/references"},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "review_due_at": {"type": "string", "format": "date"},
        "expires_at": {"type": "string", "format": "date"},
        "workpaper_fingerprint": {"$ref": "#/$defs/fingerprint"},
        "review_id": {"type": "string", "pattern": "^[0-9a-f]{24}$"}
      }
    }
  }
}
