{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opc.finance/schemas/stable-promotion-evidence.schema.json",
  "title": "OPC Finance Box stable promotion evidence",
  "description": "Input-only evidence contract for one Box fingerprint and one selected Pack version.",
  "$comment": "Runtime code additionally verifies fingerprints, exact gate coverage, freshness, Shadow arithmetic, report/review binding, multi-entity portfolio-to-report binding, entity-period coverage, hard threshold floors and separation of duties.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runtime_fingerprint",
    "pack_id",
    "pack_version",
    "prepared_by",
    "sample",
    "thresholds",
    "shadow_close_reports",
    "multi_entity_shadow_close_portfolios",
    "connector_shadow_artifacts",
    "pilot_shadow_series",
    "automated_gates",
    "rehearsals",
    "known_limitations",
    "contains_financial_results",
    "storage_boundary"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "runtime_fingerprint": {"$ref": "#/$defs/fingerprint"},
    "pack_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"},
    "pack_version": {"type": "string", "minLength": 1, "maxLength": 80},
    "prepared_by": {"$ref": "#/$defs/actor"},
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "anonymized",
        "representative",
        "entity_ids",
        "periods",
        "operator_principals",
        "evidence_references"
      ],
      "properties": {
        "description": {"type": "string", "minLength": 12, "maxLength": 500},
        "anonymized": {"const": true},
        "representative": {"const": true},
        "entity_ids": {"$ref": "#/$defs/non_empty_unique_strings"},
        "periods": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"}
        },
        "operator_principals": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/actor"}
        },
        "evidence_references": {"$ref": "#/$defs/evidence_references"}
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_distinct_entities",
        "minimum_distinct_periods",
        "minimum_comparisons_per_report",
        "minimum_match_rate",
        "maximum_accepted_exceptions",
        "required_domains",
        "maximum_shadow_age_days",
        "maximum_gate_age_days",
        "maximum_rehearsal_age_days",
        "approved_by",
        "rationale"
      ],
      "properties": {
        "minimum_distinct_entities": {"type": "integer", "minimum": 1, "maximum": 100},
        "minimum_distinct_periods": {"type": "integer", "minimum": 2, "maximum": 24},
        "minimum_comparisons_per_report": {"type": "integer", "minimum": 6, "maximum": 10000},
        "minimum_match_rate": {"type": "number", "minimum": 0.98, "maximum": 1},
        "maximum_accepted_exceptions": {"type": "integer", "minimum": 0, "maximum": 10},
        "required_domains": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"enum": ["trial_balance", "statement", "tax"]},
          "allOf": [
            {"contains": {"const": "trial_balance"}},
            {"contains": {"const": "statement"}}
          ]
        },
        "maximum_shadow_age_days": {"type": "integer", "minimum": 1, "maximum": 365},
        "maximum_gate_age_days": {"type": "integer", "minimum": 1, "maximum": 90},
        "maximum_rehearsal_age_days": {"type": "integer", "minimum": 1, "maximum": 365},
        "approved_by": {"$ref": "#/$defs/actor"},
        "rationale": {"type": "string", "minLength": 12, "maxLength": 1000}
      }
    },
    "shadow_close_reports": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2400,
      "items": {"$ref": "#/$defs/shadow_report"}
    },
    "multi_entity_shadow_close_portfolios": {
      "type": "array",
      "maxItems": 24,
      "items": {"$ref": "#/$defs/portfolio_shadow_manifest"}
    },
    "connector_shadow_artifacts": {
      "description": "Private reviewed Connector Shadow artifact paths. Required semantically for every sampled entity-period when the target Pack owns a selected network Connector.",
      "type": "array",
      "maxItems": 2400,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 4096}
    },
    "pilot_shadow_series": {
      "description": "Private reviewed consecutive Pilot Shadow receipt and its exact period evidence and Pipeline ledger roots. These paths are input-only and must never be persisted in the assessment ledger.",
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewed_receipt_path", "period_evidence_root", "pipeline_runs_root"],
      "properties": {
        "reviewed_receipt_path": {"$ref": "#/$defs/private_path"},
        "period_evidence_root": {"$ref": "#/$defs/private_path"},
        "pipeline_runs_root": {"$ref": "#/$defs/private_path"}
      }
    },
    "automated_gates": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {"$ref": "#/$defs/timed_gate"}
    },
    "rehearsals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backup_restore", "upgrade_rollback", "authorization_separation", "incident_recovery"],
      "properties": {
        "backup_restore": {"$ref": "#/$defs/timed_evidence"},
        "upgrade_rollback": {"$ref": "#/$defs/timed_evidence"},
        "authorization_separation": {"$ref": "#/$defs/timed_evidence"},
        "incident_recovery": {"$ref": "#/$defs/timed_evidence"}
      }
    },
    "known_limitations": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["limitation", "owner", "disposition", "evidence_references"],
        "properties": {
          "limitation": {"type": "string", "minLength": 6, "maxLength": 500},
          "owner": {"$ref": "#/$defs/actor"},
          "disposition": {"enum": ["resolved", "accepted_scope"]},
          "evidence_references": {"$ref": "#/$defs/evidence_references"}
        }
      }
    },
    "contains_financial_results": {"const": true},
    "storage_boundary": {"const": "input_only_not_persisted"}
  },
  "$defs": {
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "private_path": {"type": "string", "minLength": 1, "maxLength": 4096},
    "actor": {"type": "string", "minLength": 1, "maxLength": 80},
    "non_empty_unique_strings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "evidence_references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 240}
    },
    "timed_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "completed_at", "runtime_fingerprint", "evidence_references"],
      "properties": {
        "passed": {"const": true},
        "completed_at": {"type": "string", "format": "date-time"},
        "runtime_fingerprint": {"$ref": "#/$defs/fingerprint"},
        "evidence_references": {"$ref": "#/$defs/evidence_references"}
      }
    },
    "timed_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate", "passed", "completed_at", "runtime_fingerprint", "evidence_references"],
      "properties": {
        "gate": {
          "enum": [
            "unit_and_contract_tests",
            "pack_provider_audit",
            "finance_boundary_eval",
            "box_doctor",
            "installable_distribution",
            "upgrade_compatibility",
            "runtime_data_layout_preflight",
            "pipeline_ledger_integrity_and_review_state",
            "connector_sync_checkpoint_and_quarantine_controls",
            "isolated_workbench_smoke",
            "deployment_starter_controls"
          ]
        },
        "passed": {"const": true},
        "completed_at": {"type": "string", "format": "date-time"},
        "runtime_fingerprint": {"$ref": "#/$defs/fingerprint"},
        "evidence_references": {"$ref": "#/$defs/evidence_references"}
      }
    },
    "exception_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "key", "classification", "rationale", "evidence_references"],
      "properties": {
        "domain": {"enum": ["trial_balance", "statement", "tax"]},
        "key": {"type": "string", "minLength": 1},
        "classification": {
          "enum": ["mapping", "cutoff", "accounting_policy", "source_evidence", "timing", "foreign_exchange", "accepted_scope", "system_defect"]
        },
        "rationale": {"type": "string", "minLength": 12, "maxLength": 1000},
        "evidence_references": {"$ref": "#/$defs/evidence_references"}
      }
    },
    "shadow_report": {
      "type": "object",
      "required": [
        "baseline_id",
        "baseline_source_fingerprint",
        "runtime_fingerprint",
        "entity_id",
        "period",
        "report_fingerprint",
        "comparisons",
        "comparison_count",
        "matched_count",
        "exception_count",
        "domain_summary",
        "review",
        "review_current"
      ],
      "properties": {
        "baseline_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "baseline_source_fingerprint": {"$ref": "#/$defs/fingerprint"},
        "runtime_fingerprint": {"$ref": "#/$defs/fingerprint"},
        "entity_id": {"type": "string", "minLength": 1},
        "period": {"type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"},
        "report_fingerprint": {"$ref": "#/$defs/fingerprint"},
        "comparisons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["domain", "key", "manual_value", "agent_value", "difference", "allowed_tolerance", "status"],
            "properties": {
              "domain": {"enum": ["trial_balance", "statement", "tax"]},
              "key": {"type": "string", "minLength": 1},
              "manual_value": {"type": ["number", "null"]},
              "agent_value": {"type": ["number", "null"]},
              "difference": {"type": ["number", "null"]},
              "allowed_tolerance": {"type": "number", "minimum": 0},
              "status": {"enum": ["一致", "需解释", "Agent 缺项", "人工基准缺项"]}
            }
          }
        },
        "comparison_count": {"type": "integer", "minimum": 1},
        "matched_count": {"type": "integer", "minimum": 0},
        "exception_count": {"type": "integer", "minimum": 0},
        "domain_summary": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["domain", "label", "count", "matched", "exceptions"],
            "properties": {
              "domain": {"enum": ["trial_balance", "statement", "tax"]},
              "label": {"type": "string", "minLength": 1},
              "count": {"type": "integer", "minimum": 1},
              "matched": {"type": "integer", "minimum": 0},
              "exceptions": {"type": "integer", "minimum": 0}
            }
          }
        },
        "review_current": {"const": true},
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "baseline_id", "entity_id", "period", "decision", "actor", "rationale", "evidence", "reviewed_at", "report_fingerprint", "exception_resolutions", "scope_note"],
          "properties": {
            "id": {"type": "string", "pattern": "^SHADOW-REVIEW-[0-9a-f]{16}$"},
            "baseline_id": {"type": "string", "minLength": 1, "maxLength": 160},
            "entity_id": {"type": "string", "minLength": 1},
            "period": {"type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"},
            "decision": {"enum": ["验证通过", "接受差异"]},
            "actor": {"$ref": "#/$defs/actor"},
            "rationale": {"type": "string", "minLength": 6, "maxLength": 1000},
            "evidence": {"$ref": "#/$defs/evidence_references"},
            "reviewed_at": {"type": "string", "format": "date-time"},
            "report_fingerprint": {"$ref": "#/$defs/fingerprint"},
            "exception_resolutions": {
              "type": "array",
              "items": {"$ref": "#/$defs/exception_resolution"}
            },
            "scope_note": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "portfolio_shadow_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "artifact_type", "runtime_fingerprint", "period",
        "entity_ids", "entity_reports", "portfolio", "status",
        "raw_financial_values_persisted", "source_artifacts_input_only",
        "statutory_books_modified", "posting_performed", "period_close_performed",
        "external_filing_performed", "external_actions_performed", "guardrail",
        "review", "review_current", "manifest_fingerprint"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "artifact_type": {"const": "multi_entity_shadow_close_acceptance"},
        "runtime_fingerprint": {"$ref": "#/$defs/fingerprint"},
        "period": {"type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"},
        "entity_ids": {
          "type": "array", "minItems": 2, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "entity_reports": {
          "type": "array", "minItems": 2,
          "items": {"$ref": "#/$defs/portfolio_entity_report_summary"}
        },
        "portfolio": {"$ref": "#/$defs/portfolio_result_summary"},
        "status": {"const": "ready_for_independent_review"},
        "raw_financial_values_persisted": {"const": false},
        "source_artifacts_input_only": {"const": true},
        "statutory_books_modified": {"const": false},
        "posting_performed": {"const": false},
        "period_close_performed": {"const": false},
        "external_filing_performed": {"const": false},
        "external_actions_performed": {"const": false},
        "guardrail": {"type": "string", "minLength": 1},
        "review": {"$ref": "#/$defs/portfolio_shadow_review"},
        "review_current": {"const": true},
        "manifest_fingerprint": {"$ref": "#/$defs/fingerprint"}
      }
    },
    "portfolio_entity_report_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id", "baseline_id", "report_fingerprint", "review_id", "decision",
        "review_actor", "comparison_count", "matched_count", "exception_count",
        "domain_summary"
      ],
      "properties": {
        "entity_id": {"type": "string", "minLength": 1},
        "baseline_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "report_fingerprint": {"$ref": "#/$defs/fingerprint"},
        "review_id": {"type": "string", "pattern": "^SHADOW-REVIEW-[0-9a-f]{16}$"},
        "decision": {"enum": ["验证通过", "接受差异"]},
        "review_actor": {"$ref": "#/$defs/actor"},
        "comparison_count": {"type": "integer", "minimum": 1},
        "matched_count": {"type": "integer", "minimum": 0},
        "exception_count": {"type": "integer", "minimum": 0},
        "domain_summary": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["domain", "label", "count", "matched", "exceptions"],
            "properties": {
              "domain": {"enum": ["trial_balance", "statement", "tax"]},
              "label": {"type": "string", "minLength": 1},
              "count": {"type": "integer", "minimum": 1},
              "matched": {"type": "integer", "minimum": 0},
              "exceptions": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "portfolio_result_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pipeline_id", "run_id", "result_fingerprint", "source_ledger_chain_head",
        "source_attempt_ids", "source_count", "source_run_ledger_verified", "ready",
        "candidate_only", "pre_elimination_view", "raw_pipeline_results_persisted"
      ],
      "properties": {
        "pipeline_id": {"const": "finance.multi_entity_month_close_portfolio"},
        "run_id": {"type": "string", "pattern": "^[0-9a-f]{24}$"},
        "result_fingerprint": {"$ref": "#/$defs/fingerprint"},
        "source_ledger_chain_head": {"$ref": "#/$defs/fingerprint"},
        "source_attempt_ids": {
          "type": "array", "minItems": 2, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[0-9a-f]{24}$"}
        },
        "source_count": {"type": "integer", "minimum": 2},
        "source_run_ledger_verified": {"const": true},
        "ready": {"const": true},
        "candidate_only": {"const": true},
        "pre_elimination_view": {"const": true},
        "raw_pipeline_results_persisted": {"const": false}
      }
    },
    "portfolio_shadow_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "manifest_fingerprint", "decision", "actor", "rationale",
        "evidence_references", "reviewed_at", "scope_note", "review_fingerprint"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^PORTFOLIO-SHADOW-REVIEW-[0-9a-f]{16}$"},
        "manifest_fingerprint": {"$ref": "#/$defs/fingerprint"},
        "decision": {"enum": ["passed", "accepted-differences"]},
        "actor": {"$ref": "#/$defs/actor"},
        "rationale": {"type": "string", "minLength": 12, "maxLength": 1000},
        "evidence_references": {"$ref": "#/$defs/evidence_references"},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "scope_note": {"type": "string", "minLength": 1},
        "review_fingerprint": {"$ref": "#/$defs/fingerprint"}
      }
    }
  }
}
