{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opc.finance/schemas/tax-applicability-artifact.schema.json",
  "title": "OPC Finance Box tax applicability workpaper or review",
  "oneOf": [
    {"$ref": "#/$defs/workpaper"},
    {"$ref": "#/$defs/reviewed"}
  ],
  "$defs": {
    "evidenceReference": {
      "type": "string",
      "pattern": "^(evidence|document|workpaper|registry|advisor|authority)://[A-Za-z0-9][A-Za-z0-9._/#:-]{1,199}$"
    },
    "actor": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._@:-]{1,127}$"
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required", "answer", "evidence_references", "human_review_required",
        "system_determination_performed", "question_id", "prompt", "answer_type",
        "allowed_answers", "review_gate", "source_ids"
      ],
      "properties": {
        "required": {"const": true},
        "answer": {
          "type": ["string", "null"],
          "enum": [
            null, "confirmed_in_scope", "confirmed_out_of_scope", "needs_advisor_review",
            "confirmed_complete", "confirmed_not_applicable", "needs_evidence", "confirmed",
            "reviewed_no_additional_scope", "additional_scope_identified"
          ]
        },
        "evidence_references": {
          "type": "array", "maxItems": 20, "uniqueItems": true,
          "items": {"$ref": "#/$defs/evidenceReference"}
        },
        "human_review_required": {"const": true},
        "system_determination_performed": {"const": false},
        "question_id": {
          "enum": [
            "legal_form_and_pack_scope",
            "tax_residency_and_permanent_establishment",
            "direct_and_indirect_tax_registrations",
            "fiscal_year_and_return_periods",
            "special_cross_border_and_group_regimes"
          ]
        },
        "prompt": {"type": "string", "minLength": 1},
        "answer_type": {"const": "enum"},
        "allowed_answers": {
          "type": "array", "minItems": 3, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "review_gate": {"enum": ["tax_registration_confirmation", "tax_advisor_review"]},
        "source_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "reviewPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_age_days", "warning_days_before_expiry", "expiry_effect",
        "reverification_triggers"
      ],
      "properties": {
        "max_age_days": {"type": "integer", "minimum": 30, "maximum": 730},
        "warning_days_before_expiry": {"type": "integer", "minimum": 1},
        "expiry_effect": {"const": "block_external_filing_and_calendar_release"},
        "reverification_triggers": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {
            "enum": [
              "authority_source_change", "rule_effective_date_change", "pack_upgrade",
              "entity_applicability_change", "tax_registration_change"
            ]
          }
        }
      }
    },
    "applicabilityReviewPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_age_days", "warning_days_before_expiry", "expiry_effect",
        "reverification_triggers"
      ],
      "properties": {
        "max_age_days": {"type": "integer", "minimum": 30, "maximum": 730},
        "warning_days_before_expiry": {"type": "integer", "minimum": 1},
        "expiry_effect": {"const": "block_calendar_and_external_filing_release"},
        "reverification_triggers": {
          "type": "array", "minItems": 3, "uniqueItems": true,
          "items": {
            "enum": [
              "authority_source_change", "rule_effective_date_change", "pack_upgrade",
              "entity_applicability_change", "tax_registration_change"
            ]
          },
          "allOf": [
            {"contains": {"const": "pack_upgrade"}},
            {"contains": {"const": "entity_applicability_change"}},
            {"contains": {"const": "tax_registration_change"}}
          ]
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id", "jurisdiction", "functional_currency", "fiscal_year_end",
        "configured_registration_labels", "pack_id", "pack_version", "tax_readiness",
        "authority_scope", "scope_note", "review_policy", "applicability_review_policy",
        "question_count", "questions",
        "raw_tax_identifiers_requested", "external_actions_performed"
      ],
      "properties": {
        "entity_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "jurisdiction": {"type": "string", "pattern": "^[A-Z]{2}(-[A-Z0-9]{1,3})?$"},
        "functional_currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "fiscal_year_end": {"type": "string", "pattern": "^[0-9]{2}-[0-9]{2}$"},
        "configured_registration_labels": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "pack_id": {"type": "string", "pattern": "^jurisdiction\\.[a-z0-9_]+$"},
        "pack_version": {"type": "string", "minLength": 1},
        "tax_readiness": {"enum": ["design", "workpaper", "filing_assist"]},
        "authority_scope": {"type": "string", "minLength": 1},
        "scope_note": {"type": "string", "minLength": 1},
        "review_policy": {"$ref": "#/$defs/reviewPolicy"},
        "applicability_review_policy": {
          "$ref": "#/$defs/applicabilityReviewPolicy"
        },
        "question_count": {"const": 5},
        "questions": {
          "type": "array", "minItems": 5, "maxItems": 5,
          "items": {"$ref": "#/$defs/question"}
        },
        "raw_tax_identifiers_requested": {"const": false},
        "external_actions_performed": {"const": false}
      }
    },
    "common": {
      "type": "object",
      "required": [
        "schema_version", "artifact_type", "runtime_fingerprint",
        "questionnaire_fingerprint", "facts_as_of", "prepared_by", "entity", "instructions",
        "template_only", "raw_tax_identifiers_included", "tax_calculation_performed",
        "external_actions_performed"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "runtime_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "questionnaire_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "facts_as_of": {"type": "string", "format": "date"},
        "prepared_by": {"$ref": "#/$defs/actor"},
        "entity": {"$ref": "#/$defs/entity"},
        "instructions": {
          "type": "array", "minItems": 3,
          "items": {"type": "string", "minLength": 1}
        },
        "template_only": {"const": false},
        "raw_tax_identifiers_included": {"const": false},
        "tax_calculation_performed": {"const": false},
        "external_actions_performed": {"const": false}
      }
    },
    "workpaper": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {
          "type": "object",
          "required": ["artifact_type"],
          "properties": {"artifact_type": {"const": "tax_applicability_workpaper"}}
        }
      ],
      "unevaluatedProperties": false
    },
    "reviewSignature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workpaper_fingerprint", "decision", "actor", "rationale",
        "evidence_references", "reviewed_at", "review_id"
      ],
      "properties": {
        "workpaper_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "decision": {
          "enum": ["approved-in-scope", "confirmed-out-of-scope", "needs-correction"]
        },
        "actor": {"$ref": "#/$defs/actor"},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 1000},
        "evidence_references": {
          "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true,
          "items": {"$ref": "#/$defs/evidenceReference"}
        },
        "reviewed_at": {"type": "string", "format": "date-time"},
        "review_id": {"type": "string", "pattern": "^[0-9a-f]{24}$"}
      }
    },
    "reviewed": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {
          "type": "object",
          "required": [
            "artifact_type", "workpaper_fingerprint", "review_due_at", "expires_at",
            "unanswered_count",
            "applicability_gate_passed", "review", "review_current"
          ],
          "properties": {
            "artifact_type": {"const": "tax_applicability_review"},
            "workpaper_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "review_due_at": {"type": "string", "format": "date"},
            "expires_at": {"type": "string", "format": "date"},
            "unanswered_count": {"type": "integer", "minimum": 0, "maximum": 5},
            "applicability_gate_passed": {"type": "boolean"},
            "review": {"$ref": "#/$defs/reviewSignature"},
            "review_current": {"const": true}
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
