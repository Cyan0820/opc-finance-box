{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opc.finance/schemas/pilot-shadow-series-artifact.schema.json",
  "title": "OPC Finance Box consecutive Pilot Shadow series receipt",
  "description": "Private no-values receipt that binds two or more consecutive, fully reverified Pilot Shadow observation periods before stable-promotion evidence preparation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "runtime_fingerprint",
    "entity_ids",
    "minimum_consecutive_periods",
    "periods",
    "period_observations",
    "transitions",
    "series_result_candidate",
    "status",
    "source_artifacts_input_only",
    "raw_financial_values_persisted",
    "statutory_books_modified",
    "posting_performed",
    "payment_performed",
    "period_close_performed",
    "external_filing_performed",
    "external_actions_performed",
    "guardrail",
    "receipt_fingerprint",
    "review",
    "review_current"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_type": {"const": "pilot_shadow_series_receipt"},
    "runtime_fingerprint": {"$ref": "#/$defs/fingerprint"},
    "entity_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 2, "maxLength": 80}
    },
    "minimum_consecutive_periods": {"const": 2},
    "periods": {
      "type": "array",
      "minItems": 2,
      "maxItems": 24,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/period"}
    },
    "period_observations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 24,
      "items": {"$ref": "#/$defs/period_observation"}
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 23,
      "items": {"$ref": "#/$defs/transition"}
    },
    "series_result_candidate": {
      "enum": ["ready_for_promotion_evidence", "needs_correction"]
    },
    "status": {"const": "ready_for_independent_review"},
    "source_artifacts_input_only": {"const": true},
    "raw_financial_values_persisted": {"const": false},
    "statutory_books_modified": {"const": false},
    "posting_performed": {"const": false},
    "payment_performed": {"const": false},
    "period_close_performed": {"const": false},
    "external_filing_performed": {"const": false},
    "external_actions_performed": {"const": false},
    "guardrail": {"type": "string", "minLength": 40, "maxLength": 1000},
    "receipt_fingerprint": {"$ref": "#/$defs/fingerprint"},
    "review": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/review"}
      ]
    },
    "review_current": {"type": "boolean"}
  },
  "$defs": {
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id24": {"type": "string", "pattern": "^[0-9a-f]{24}$"},
    "period": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"},
    "actor": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._@:-]+$"
    },
    "reference": {
      "type": "string",
      "minLength": 5,
      "maxLength": 508,
      "pattern": "^(evidence|document|workpaper|registry|advisor|authority|audit|review)://[^\\s]+$"
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/reference"}
    },
    "period_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "period",
        "observation_receipt_fingerprint",
        "observation_review_id",
        "observation_review_decision",
        "observation_reviewer",
        "source_bundle_fingerprint",
        "comparison_count",
        "matched_count",
        "exception_count",
        "system_defect_count",
        "ready_for_next_shadow_period",
        "separation_principals"
      ],
      "properties": {
        "period": {"$ref": "#/$defs/period"},
        "observation_receipt_fingerprint": {"$ref": "#/$defs/fingerprint"},
        "observation_review_id": {"$ref": "#/$defs/id24"},
        "observation_review_decision": {
          "enum": ["passed", "accepted-differences", "needs-correction"]
        },
        "observation_reviewer": {"$ref": "#/$defs/actor"},
        "source_bundle_fingerprint": {"$ref": "#/$defs/fingerprint"},
        "comparison_count": {"type": "integer", "minimum": 0},
        "matched_count": {"type": "integer", "minimum": 0},
        "exception_count": {"type": "integer", "minimum": 0},
        "system_defect_count": {"type": "integer", "minimum": 0},
        "ready_for_next_shadow_period": {"type": "boolean"},
        "separation_principals": {
          "type": "array",
          "minItems": 3,
          "maxItems": 400,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/actor"}
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_period",
        "to_period",
        "consecutive",
        "comparison_count_delta",
        "matched_count_delta",
        "exception_count_delta",
        "system_defect_count_delta",
        "exception_trend"
      ],
      "properties": {
        "from_period": {"$ref": "#/$defs/period"},
        "to_period": {"$ref": "#/$defs/period"},
        "consecutive": {"const": true},
        "comparison_count_delta": {"type": "integer"},
        "matched_count_delta": {"type": "integer"},
        "exception_count_delta": {"type": "integer"},
        "system_defect_count_delta": {"type": "integer"},
        "exception_trend": {"enum": ["improved", "unchanged", "worsened"]}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_id",
        "receipt_fingerprint",
        "decision",
        "actor",
        "rationale",
        "evidence_references",
        "reviewed_at",
        "scope_note",
        "review_fingerprint"
      ],
      "properties": {
        "review_id": {"$ref": "#/$defs/id24"},
        "receipt_fingerprint": {"$ref": "#/$defs/fingerprint"},
        "decision": {
          "enum": ["approved-for-promotion-evidence", "needs-correction"]
        },
        "actor": {"$ref": "#/$defs/actor"},
        "rationale": {"type": "string", "minLength": 12, "maxLength": 1000},
        "evidence_references": {"$ref": "#/$defs/references"},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "scope_note": {"type": "string", "minLength": 40, "maxLength": 1000},
        "review_fingerprint": {"$ref": "#/$defs/fingerprint"}
      }
    }
  }
}
