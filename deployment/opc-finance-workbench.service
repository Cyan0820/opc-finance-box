[Unit]
Description=OPC Finance Box workbench
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opc-finance
Group=opc-finance
EnvironmentFile=/etc/opc-finance/box.env
ExecStartPre=/opt/opc-finance/venv/bin/opc-finance-box runtime-data-init /var/lib/opc-finance --actor systemd-workbench-bootstrap
ExecStart=/opt/opc-finance/venv/bin/opc-finance-workbench
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/opc-finance

[Install]
WantedBy=multi-user.target
