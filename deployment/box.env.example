# Copy to /etc/opc-finance/box.env, set owner root:opc-finance and mode 0640.
# Values are examples only. Do not put raw API or Connector secrets in this file.
OPC_FINANCE_BOX_CONFIG=/etc/opc-finance/box.json
# Omit to use the Pack catalog bundled in the installed wheel.
# OPC_FINANCE_PACKS_ROOT=/opt/opc-finance/editable-packs
OPC_FINANCE_DATA_DIR=/var/lib/opc-finance
OPC_FINANCE_HOST=127.0.0.1
OPC_FINANCE_PORT=8765
OPC_FINANCE_API_AUTH_FILE=/etc/opc-finance/api-auth.json
# Optional read-only directory containing exact <entity_id>.json applicability reviews.
# OPC_TAX_APPLICABILITY_REVIEW_DIR=/etc/opc-finance/tax-applicability-reviews
# Required with the review directory for runtime calendar release; mode 0600.
# OPC_TAX_APPLICABILITY_REGISTRY_RECEIPT=/etc/opc-finance/tax-applicability-registry-receipt.json
# Optional read-only 0700 directory of current 0600 schema-v2 Connector Shadow reviews.
# OPC_CONNECTOR_SHADOW_REVIEW_DIR=/etc/opc-finance/connector-shadow-reviews
# Optional private 0600 review that activates bounded Shadow Close readiness.
# OPC_PILOT_READINESS_REVIEW=/etc/opc-finance/pilot-readiness-reviewed.json
# Optional private 0600 handoff review; requires the matching Pilot readiness review.
# OPC_PILOT_DATA_HANDOFF_REVIEW=/etc/opc-finance/pilot-data-handoff-reviewed.json
# Optional private 0600 first Shadow Run registration; requires both reviews and the live ledger.
# OPC_PILOT_SHADOW_RUN_REGISTRATION=/etc/opc-finance/pilot-shadow-run-registration.json
# Optional private 0600 fourth-role review for the first Shadow observation.
# OPC_PILOT_SHADOW_OBSERVATION_REVIEW=/etc/opc-finance/pilot-shadow-observation-reviewed.json
# Required with the observation review; contains only exact <entity_id>.json private reports.
# OPC_PILOT_SHADOW_ENTITY_REPORT_DIR=/etc/opc-finance/pilot-shadow-entity-reports
# Required only for a multi-entity Box; forbidden for a single-entity Box.
# OPC_PILOT_SHADOW_PORTFOLIO_REVIEW=/etc/opc-finance/pilot-shadow-portfolio-reviewed.json
# Optional private 0600 review for two or more consecutive Shadow periods.
# OPC_PILOT_SHADOW_SERIES_REVIEW=/etc/opc-finance/pilot-shadow-series-reviewed.json
# Required with the series review; contains only exact consecutive YYYY-MM evidence directories.
# OPC_PILOT_SHADOW_SERIES_EVIDENCE_ROOT=/etc/opc-finance/pilot-shadow-series-periods
# Optional read-only Activation root for path-free monthly workspace/Runbook projection.
# OPC_ACTIVATION_WORKSPACE_ROOT=/etc/opc-finance/activation-workspace
# Optional read-only 0700 directory containing the verified stable-promotion hash-chain ledger.
# OPC_STABLE_PROMOTION_ROOT=/etc/opc-finance/stable-promotion-ledger
# Uncomment all three only after schedule/request approval and before enabling the timer.
# OPC_FINANCE_PIPELINE_SCHEDULE_FILE=/etc/opc-finance/schedule.json
# OPC_FINANCE_PIPELINE_RUNS_ROOT=/var/lib/opc-finance/pipeline-runs
# OPC_FINANCE_SCHEDULER_ACTOR=scheduler_operator

# Inject Connector secrets with systemd credentials, a secret manager, or the
# process supervisor. Discover the exact names for this Box in
# deployment-environment-contract.json. Never commit their values.
# OPC_XERO_ACCESS_TOKEN=INJECT_WITH_SECRET_MANAGER
# OPC_XERO_ENTITY_BINDINGS_JSON=INJECT_WITH_SECRET_MANAGER_OR_PROTECTED_ENV_FILE
# OPC_WISE_ACCESS_TOKEN=INJECT_WITH_SECRET_MANAGER
# OPC_WISE_ENTITY_BINDINGS_JSON=INJECT_WITH_SECRET_MANAGER_OR_PROTECTED_ENV_FILE
# OPC_AIRWALLEX_CLIENT_ID=INJECT_WITH_SECRET_MANAGER
# OPC_AIRWALLEX_API_KEY=INJECT_WITH_SECRET_MANAGER
# OPC_AIRWALLEX_ENTITY_BINDINGS_JSON=INJECT_WITH_SECRET_MANAGER_OR_PROTECTED_ENV_FILE
# OPC_AIRWALLEX_WEBHOOK_SECRET=INJECT_WITH_SECRET_MANAGER
# OPC_PAYPAL_CLIENT_ID=INJECT_WITH_SECRET_MANAGER
# OPC_PAYPAL_CLIENT_SECRET=INJECT_WITH_SECRET_MANAGER
# OPC_PAYPAL_ENTITY_BINDINGS_JSON=INJECT_WITH_SECRET_MANAGER_OR_PROTECTED_ENV_FILE
# OPC_PAYPAL_ENTITY_CLIENT_ID_ALIAS=INJECT_WITH_SECRET_MANAGER
# OPC_PAYPAL_ENTITY_CLIENT_SECRET_ALIAS=INJECT_WITH_SECRET_MANAGER
# OPC_SHIPBOB_ACCESS_TOKEN=INJECT_WITH_SECRET_MANAGER
# OPC_SHIPBOB_ENTITY_BINDINGS_JSON=INJECT_WITH_SECRET_MANAGER_OR_PROTECTED_ENV_FILE
# OPC_SHIPBOB_ENTITY_TOKEN_ALIAS=INJECT_WITH_SECRET_MANAGER
# OPC_WOOCOMMERCE_SITE_ORIGIN=INJECT_WITH_PROTECTED_ENV_CONFIGURATION
# OPC_WOOCOMMERCE_CONSUMER_KEY=INJECT_WITH_SECRET_MANAGER
# OPC_WOOCOMMERCE_CONSUMER_SECRET=INJECT_WITH_SECRET_MANAGER
# OPC_WOOCOMMERCE_ENTITY_BINDINGS_JSON=INJECT_WITH_SECRET_MANAGER_OR_PROTECTED_ENV_FILE
# OPC_WOOCOMMERCE_ENTITY_KEY_ALIAS=INJECT_WITH_SECRET_MANAGER
# OPC_WOOCOMMERCE_ENTITY_SECRET_ALIAS=INJECT_WITH_SECRET_MANAGER
# OPC_AMAZON_SELLER_CLIENT_ID=INJECT_WITH_SECRET_MANAGER
# OPC_AMAZON_SELLER_CLIENT_SECRET=INJECT_WITH_SECRET_MANAGER
# OPC_AMAZON_SELLER_REFRESH_TOKEN=INJECT_WITH_SECRET_MANAGER
# OPC_AMAZON_SELLER_REGION=INJECT_WITH_PROTECTED_ENV_CONFIGURATION
# OPC_AMAZON_SELLER_ID=INJECT_WITH_PROTECTED_ENV_CONFIGURATION
# OPC_AMAZON_SELLER_MARKETPLACE_IDS_JSON=INJECT_WITH_PROTECTED_ENV_CONFIGURATION
# OPC_AMAZON_SELLER_ENTITY_BINDINGS_JSON=INJECT_WITH_SECRET_MANAGER_OR_PROTECTED_ENV_FILE
# OPC_AMAZON_SELLER_ENTITY_CLIENT_ID_ALIAS=INJECT_WITH_SECRET_MANAGER
# OPC_AMAZON_SELLER_ENTITY_CLIENT_SECRET_ALIAS=INJECT_WITH_SECRET_MANAGER
# OPC_AMAZON_SELLER_ENTITY_REFRESH_TOKEN_ALIAS=INJECT_WITH_SECRET_MANAGER
