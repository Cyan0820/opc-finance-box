{
  "schema_version": 1,
  "pack_id": "connector.paypal",
  "credential_env": ["OPC_PAYPAL_CLIENT_ID", "OPC_PAYPAL_CLIENT_SECRET"],
  "entity_credential_binding_env": "OPC_PAYPAL_ENTITY_BINDINGS_JSON",
  "entity_credential_binding_required_for_access_probe_and_shadow": true,
  "entity_credential_alias_fields": ["client_id_env", "client_secret_env"],
  "entity_provider_binding_fields": ["environment", "app_id", "account_id"],
  "required_access_scope": "https://uri.paypal.com/services/reporting/search/read",
  "required_app_feature": "Transaction Search",
  "network_mode": "in_memory_oauth_token_exchange_then_read_only_transaction_search",
  "api_contract": "Transaction Search v1",
  "production_host": "api-m.paypal.com",
  "sandbox_host": "api-m.sandbox.paypal.com",
  "endpoints": ["POST /v1/oauth2/token", "GET /v1/reporting/transactions"],
  "access_probe_contract": {
    "receipt_schema": 2,
    "scope": "one_box_legal_entity_one_bound_rest_app_one_bound_merchant_account",
    "fixed_endpoints": ["POST /v1/oauth2/token", "GET /v1/reporting/balances"],
    "required_checks": ["provider_authentication", "provider_account_binding", "required_reporting_scope", "rest_app_binding", "reporting_balance_read_scope", "read_only_probe"],
    "balance_values_requested": true,
    "balance_values_retained": false,
    "provider_identifiers_returned": false,
    "current_receipt_required_for_shadow_dispatch": true
  },
  "transaction_query": "fields=transaction_info and balance_affecting_records_only=Y",
  "pagination": "locally_constructed_pages_1_to_20_hateoas_links_are_never_followed",
  "window_contract": "maximum_31_day_half_open_box_interval_converted_to_inclusive_api_end",
  "record_limit": 10000,
  "pii_collection": "transaction_info_only_no_payer_shipping_cart_or_free_text",
  "source_id_policy": "hash_transaction_and_reference_identifiers",
  "accounting_boundary": "processor_activity_evidence_not_revenue_bank_reconciliation_or_posting",
  "third_party_access_boundary": "central_multi_merchant_access_requires_paypal_partner_network_approval",
  "business_write_endpoints_used": false,
  "webhooks_used": false
}
