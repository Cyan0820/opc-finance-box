  "rules": [
    {
      "id": "ie.company.ltd.scope.evidence",
      "summary": "确认主体是本 Pack 覆盖的爱尔兰 Private Company Limited by Shares，并分别保存 CRO 状态和税务居民复核证据；不收集 company number 原值。",
      "effective_from": "2026-08-13",
      "automation_level": "evidence",
      "human_review_required": true,
      "source_ids": ["ie_cro_ltd_company_type_current", "ie_revenue_company_residence_2026"]
    },
    {
      "id": "ie.tax.ct.registration.evidence",
      "summary": "保存 Revenue tax reference、Corporation Tax 登记与 ROS/CT1 filing scope 的证据引用；不保存税号原值，也不代为登记。",
      "effective_from": "2026-06-04",
      "automation_level": "evidence",
      "human_review_required": true,
      "source_ids": ["ie_revenue_tax_registration_2026", "ie_revenue_ct_payment_filing_2025"]
    },
    {
      "id": "ie.vat.registration.monitor",
      "summary": "监控货物/服务构成、calendar-year turnover、EU distance sales/TBE、acquisitions、境内设立与供应事实，形成 VAT 登记复核提示；系统不自动选择 threshold 或 OSS/IOSS/SME scheme。",
      "effective_from": "2026-05-06",
      "automation_level": "evidence",
      "human_review_required": true,
      "source_ids": ["ie_revenue_vat_thresholds_2026"]
    },
    {
      "id": "ie.ct1.return.calendar",
      "summary": "CT1 期限受 accounting period end 的日期位置、9 个月规则、强制电子申报/豁免、ROS 日期及短长会计期间影响，必须按主体人工配置。",
      "effective_from": "2026-08-13",
      "automation_level": "calendar",
      "human_review_required": true,
      "review_gate": "tax_advisor_review",
      "schedule": {
        "kind": "manual_configuration",
        "required_fields": [
          "confirmed_accounting_period_end",
          "mandatory_e_filing_or_exemption",
          "nine_month_and_day_rule_review",
          "ros_account_due_date_reference",
          "approved_ct1_due_date"
        ],
        "registration_any": ["corporation_tax", "ct1_filer", "ie_private_limited_company"]
      },
      "source_ids": ["ie_revenue_ct1_filing_deadline_2026"]
    },
    {
      "id": "ie.corporation_tax.payment.calendar",
      "summary": "preliminary CT、final balance 与 payment dates 取决于公司规模、accounting period、税额、付款阶段和实际 ROS 账户，必须人工配置。",
      "effective_from": "2025-10-01",
      "automation_level": "calendar",
      "human_review_required": true,
      "review_gate": "tax_advisor_review",
      "schedule": {
        "kind": "manual_configuration",
        "required_fields": [
          "confirmed_accounting_period",
          "small_or_large_company_review",
          "preliminary_ct_basis_and_installments",
          "ros_payment_due_date_reference",
          "approved_ct_payment_dates"
        ],
        "registration_any": ["corporation_tax", "ct1_filer", "ie_private_limited_company"]
      },
      "source_ids": ["ie_revenue_ct_payment_filing_2025"]
    },
    {
      "id": "ie.vat.return_payment.calendar",
      "summary": "VAT3 申报付款日取决于实际登记、taxable period frequency、ROS/非 ROS、RTD、Revenue 授权和实际账户日期，必须按主体人工配置。",
      "effective_from": "2026-07-28",
      "automation_level": "calendar",
      "human_review_required": true,
      "review_gate": "tax_advisor_review",
      "schedule": {
        "kind": "manual_configuration",
        "required_fields": [
          "confirmed_vat_registration",
          "taxable_period_frequency",
          "taxable_period_end",
          "ros_or_non_ros_filing",
          "rtd_requirement_review",
          "approved_vat3_return_and_payment_due_date"
        ],
        "registration_any": ["vat", "vat_registered", "ie_vat"]
      },
      "source_ids": ["ie_revenue_vat_due_2026"]
    },
    {
      "id": "ie.cro.annual_return.calendar",
      "summary": "annual return 应在 CRO 分配的 Annual Return Date 后 56 天内提交；仅在提供当期 ARD 锚点时生成候选，并仍须核对 first return、ARD 变更和财务报表要求。",
      "effective_from": "2026-08-13",
      "automation_level": "calendar",
      "human_review_required": true,
      "review_gate": "tax_advisor_review",
      "schedule": {
        "kind": "days_after_date",
        "anchor": "cro_annual_return_date",
        "days": 56,
        "registration_any": ["ie_private_limited_company", "cro_company", "cro_annual_return"]
      },
      "source_ids": ["ie_cro_annual_return_date_current"]
    },
    {
      "id": "ie.ct1.return.evidence",
      "summary": "整理批准财务报表、CT1/iXBRL 与税务调整、preliminary tax/VAT/EU 复核、授权、付款与回执计划；design Pack 不计算税额或生成可提交文件。",
      "effective_from": "2026-08-13",
      "automation_level": "evidence",
      "human_review_required": true,
      "source_ids": ["ie_revenue_ct_payment_filing_2025", "ie_revenue_ct1_filing_deadline_2026"]
    }
  ]
}
