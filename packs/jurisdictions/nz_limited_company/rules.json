  "rules": [
    {
      "id": "nz.company.limited.scope.evidence",
      "summary": "确认主体是本 Pack 覆盖的新西兰注册有限公司，分别保存 Companies Register 状态和税务居民复核证据；不收集 company number 或 NZBN 原值。",
      "effective_from": "2026-08-13",
      "automation_level": "evidence",
      "human_review_required": true,
      "source_ids": ["nz_companies_incorporation_current", "nz_ird_company_residency_current"]
    },
    {
      "id": "nz.tax.ird_ir4.registration.evidence",
      "summary": "保存公司 IRD number 登记与 IR4 filing scope 的证据引用；不保存 IRD number 原值，也不代为登记。",
      "effective_from": "2026-08-13",
      "automation_level": "evidence",
      "human_review_required": true,
      "source_ids": ["nz_ird_business_number_2026", "nz_ird_company_income_tax_current"]
    },
    {
      "id": "nz.gst.registration.monitor",
      "summary": "监控过去及预计未来 12 个月 taxable activity turnover、是否在价格中加 GST 和供应事实，形成登记复核提示；订单额或新西兰收货地不能自动证明 GST 登记义务。",
      "effective_from": "2026-08-13",
      "automation_level": "evidence",
      "human_review_required": true,
      "source_ids": ["nz_ird_gst_registration_current"]
    },
    {
      "id": "nz.ir4.return.calendar",
      "summary": "IR4 申报日取决于 balance date、是否有 tax agent、extension of time 和实际 myIR 账户日期，必须按主体人工配置。",
      "effective_from": "2026-08-13",
      "automation_level": "calendar",
      "human_review_required": true,
      "review_gate": "tax_advisor_review",
      "schedule": {
        "kind": "manual_configuration",
        "required_fields": [
          "confirmed_balance_date",
          "tax_agent_status",
          "extension_of_time_status",
          "myir_return_due_date_reference",
          "approved_ir4_due_date"
        ],
        "registration_any": ["ir4_filer", "company_income_tax", "nz_limited_company"]
      },
      "source_ids": ["nz_ird_company_income_tax_current"]
    },
    {
      "id": "nz.income_tax.payment.calendar",
      "summary": "公司 income tax 与 provisional tax 付款日取决于 balance date、RIT、方法、分期、tax agent 和实际 Inland Revenue 账户，必须人工配置。",
      "effective_from": "2026-08-13",
      "automation_level": "calendar",
      "human_review_required": true,
      "review_gate": "tax_advisor_review",
      "schedule": {
        "kind": "manual_configuration",
        "required_fields": [
          "confirmed_balance_date",
          "residual_income_tax_review",
          "provisional_tax_method_and_installments",
          "tax_agent_extension_review",
          "approved_income_tax_payment_dates"
        ],
        "registration_any": ["ir4_filer", "company_income_tax", "nz_limited_company"]
      },
      "source_ids": ["nz_ird_company_income_tax_current"]
    },
    {
      "id": "nz.gst.return_payment.calendar",
      "summary": "GST return/payment 日期取决于实际登记、filing frequency、accounting basis、taxable period、特殊 31 March/30 November 期间及周末/公共假日，必须按实际账户人工配置。",
      "effective_from": "2024-05-13",
      "automation_level": "calendar",
      "human_review_required": true,
      "review_gate": "tax_advisor_review",
      "schedule": {
        "kind": "manual_configuration",
        "required_fields": [
          "confirmed_gst_registration",
          "gst_filing_frequency",
          "gst_accounting_basis",
          "taxable_period_end",
          "special_period_and_holiday_review",
          "approved_return_and_payment_due_date"
        ],
        "registration_any": ["gst", "gst_registered", "nz_gst"]
      },
      "source_ids": ["nz_ird_gst_filing_2024"]
    },
    {
      "id": "nz.companies_office.annual_return.calendar",
      "summary": "公司首次 annual return 从注册后下一日历年开始，其后在 Companies Register 分配的 filing month 内完成；当前只按真实 register 状态人工配置。",
      "effective_from": "2026-08-13",
      "automation_level": "calendar",
      "human_review_required": true,
      "review_gate": "tax_advisor_review",
      "schedule": {
        "kind": "manual_configuration",
        "required_fields": [
          "company_active_status",
          "incorporation_year",
          "assigned_filing_month",
          "register_due_status_reference",
          "approved_annual_return_due_date"
        ],
        "registration_any": ["nz_limited_company", "companies_register_company", "companies_office_annual_return"]
      },
      "source_ids": ["nz_companies_annual_return_current"]
