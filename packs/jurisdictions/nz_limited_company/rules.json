    {
      "id": "nz.ir4.return.evidence",
      "summary": "整理批准财务报表、IR4/IR10 与税务调整、imputation/provisional tax 复核、授权、付款与回执计划；design Pack 不计算税额或生成可提交文件。",
      "effective_from": "2026-08-13",
