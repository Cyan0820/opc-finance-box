  "rules": [
    {
      "id": "jp.company.domestic.scope.evidence",
      "summary": "确认主体是本 Pack 覆盖的日本内国株式会社或合同会社，分别保存商业登记、法律形式、总部所在地和税务居民专业复核证据；不收集法人番号原值。",
      "effective_from": "2026-08-16",
      "automation_level": "evidence",
      "human_review_required": true,
      "source_ids": ["jp_moj_commercial_registration_current", "jp_nta_corporate_number_current"]
    },
    {
      "id": "jp.corporation_tax.registration.evidence",
      "summary": "保存法人设立届、法人税、e-Tax、事业年度与青色申告状态的证据；不判断蓝色申报资格、集团通算、税率、税额或中间申报义务。",
      "effective_from": "2026-08-16",
      "automation_level": "evidence",
      "human_review_required": true,
      "source_ids": ["jp_nta_corporation_startup_current", "jp_nta_corporation_return_current"]
    },
    {
      "id": "jp.local_corporate_tax.registration.evidence",
      "summary": "保存实际都道府县和市区町村的法人住民税、法人事业税及 eLTAX/地方申报路径证据；不推断自治体、均等割、外形标准课税、税率或税额。",
      "effective_from": "2026-08-16",
      "automation_level": "evidence",
      "human_review_required": true,
      "source_ids": ["jp_etax_local_forms_current"]
    },
    {
      "id": "jp.consumption_tax.invoice.evidence",
      "summary": "保存消费税课税身份、课税期间、简易课税选择与适格请求书发行事业者登记的复核证据；不依销售额、资本额或登记状态自动判定纳税义务、税率、供应分类或进项抵扣。",
      "effective_from": "2026-08-16",
      "automation_level": "evidence",
      "human_review_required": true,
      "source_ids": ["jp_nta_consumption_tax_current", "jp_nta_invoice_system_current"]
    },
    {
      "id": "jp.withholding.registration.evidence",
      "summary": "保存工资支付事务所、源泉扣缴义务及纳期特例批准证据；不根据 OPC 人数、创始人报酬或供应商类型自动判定扣缴义务。",
      "effective_from": "2026-08-16",
      "automation_level": "evidence",
      "human_review_required": true,
      "source_ids": ["jp_nta_withholding_current", "jp_nta_corporation_startup_current"]
    },
    {
      "id": "jp.corporation_tax.return_payment.calendar",
      "summary": "法人税、地方法人税及可能适用的防卫特别法人税，原则期限、延期、中间申报、休假日和实际 e-Tax 账户状态均须按主体复核并人工批准。",
      "effective_from": "2026-08-16",
      "automation_level": "calendar",
      "human_review_required": true,
      "review_gate": "tax_advisor_review",
      "schedule": {
        "kind": "manual_configuration",
        "required_fields": [
          "confirmed_fiscal_year_end",
          "extension_status_review",
          "interim_return_applicability_review",
          "defense_special_corporation_tax_review",
          "etax_access_review",
          "approved_corporation_tax_return_and_payment_due_date"
        ],
        "registration_any": ["jp_domestic_corporation", "kabushiki_kaisha", "godo_kaisha", "corporation_tax"]
      },
      "source_ids": ["jp_nta_corporation_return_current"]
    },
    {
      "id": "jp.local_corporate_tax.return_payment.calendar",
      "summary": "地方税取决于实际都道府县、市区町村、办公地点、法人类型、延期和 eLTAX/自治体通知；本 Pack 不计算统一日期，必须保存主管机关确认的批准日期。",
      "effective_from": "2026-08-16",
      "automation_level": "calendar",
      "human_review_required": true,
      "review_gate": "tax_advisor_review",
      "schedule": {
        "kind": "manual_configuration",
        "required_fields": [
          "confirmed_prefecture_and_municipality",
          "local_office_and_establishment_review",
          "local_tax_registration_review",
          "extension_status_review",
          "eltax_or_local_channel_review",
          "approved_local_corporate_tax_return_and_payment_due_date"
        ],
        "registration_any": ["jp_domestic_corporation", "local_corporate_tax", "corporate_inhabitant_tax", "corporate_enterprise_tax"]
      },
      "source_ids": ["jp_etax_local_forms_current"]
    },
    {
      "id": "jp.consumption_tax.return_payment.calendar",
      "summary": "法人消费税期限受课税身份、课税期间缩短、中间申报、事业年度和实际登记影响；常见两个月规则不能替代主体账户与税理士确认。",
      "effective_from": "2026-08-16",
      "automation_level": "calendar",
      "human_review_required": true,
      "review_gate": "tax_advisor_review",
      "schedule": {
        "kind": "manual_configuration",
        "required_fields": [
          "confirmed_consumption_taxable_person_status",
          "confirmed_taxable_period",
          "shortened_period_and_interim_return_review",
          "simplified_tax_system_review",
          "etax_account_due_date_reference",
          "approved_consumption_tax_return_and_payment_due_date"
        ],
        "registration_any": ["consumption_tax", "consumption_taxable_person", "qualified_invoice_issuer"]
      },
      "source_ids": ["jp_nta_consumption_tax_current", "jp_nta_consumption_return_deadline_current"]
    },
    {
      "id": "jp.withholding_tax.payment.calendar",
      "summary": "源泉所得税期限取决于实际付款、收入类型、扣缴义务和纳期特例批准；不得仅凭 OPC 人数或工资存在自动采用月度或半年期限。",
      "effective_from": "2026-08-16",
      "automation_level": "calendar",
      "human_review_required": true,
      "review_gate": "tax_advisor_review",
      "schedule": {
        "kind": "manual_configuration",
        "required_fields": [
          "confirmed_withholding_obligation",
          "payment_types_and_dates_review",
          "special_payment_deadline_approval_review",
          "withholding_payment_statement_review",
          "approved_withholding_payment_due_date"
        ],
        "registration_any": ["withholding_tax", "payroll_office", "withholding_agent"]
      },
      "source_ids": ["jp_nta_withholding_current"]
    },
    {
      "id": "jp.return.evidence",
      "summary": "整理批准财务报表、法人税/地方税/消费税/源泉税底稿、e-Tax/eLTAX 授权、付款计划和回执计划；design Pack 不计算税额或生成可提交文件。",
      "effective_from": "2026-08-16",
      "automation_level": "evidence",
      "human_review_required": true,
      "source_ids": [
        "jp_nta_corporation_return_current",
        "jp_nta_consumption_return_deadline_current",
        "jp_nta_withholding_current",
        "jp_etax_local_forms_current"
      ]
    }
  ]
}
