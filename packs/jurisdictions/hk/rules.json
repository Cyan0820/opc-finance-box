  "rules": [
    {
      "id": "hk.business_registration.brn.evidence",
      "summary": "保存法团 BRN/UBI 的证书或官方引用、法定名称匹配和登记适用性复核；系统不收集或展示完整 BRN 值。",
      "effective_from": "2023-12-27",
      "automation_level": "evidence",
      "human_review_required": true,
      "source_ids": ["hk_ird_unique_business_identifier"]
    },
    {
      "id": "hk.profits_tax.corporation_scope.evidence",
      "summary": "确认主体是本 Pack 覆盖的法团，并保存 BIR51/利得税登记范围与业务事实；不据此自动判断某项利润是否源自香港。",
      "effective_from": "2025-04-01",
      "automation_level": "evidence",
      "human_review_required": true,
      "source_ids": ["hk_ird_profits_tax_current", "hk_ird_bir51_notes_2025_26"]
    },
    {
      "id": "hk.profits_tax.two_tier_eligibility.evidence",
      "summary": "整理关联实体、当年提名、优惠税率制度和不可撤销选择证据；是否适用两级税率必须由香港税务复核人确认。",
      "effective_from": "2018-04-01",
      "automation_level": "evidence",
      "human_review_required": true,
      "source_ids": ["hk_ird_two_tiered_rates_faq"]
    },
    {
      "id": "hk.profits_tax.bir51.calendar",
      "summary": "BIR51 期限与发出日期、税务代表延期、电子提交安排和当年 IRD 通知相关；必须按实际 return 与当年官方资料人工配置候选日期。",
      "effective_from": "2025-04-01",
      "automation_level": "calendar",
      "human_review_required": true,
