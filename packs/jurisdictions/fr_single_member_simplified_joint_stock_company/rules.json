      "title": "Fiscalité de la société par actions simplifiée unipersonnelle (SASU) : ce qu'il faut savoir",
      "url": "https://entreprendre.service-public.gouv.fr/vosdroits/F36215",
      "effective_from": "2026-02-21",
      "status": "official guidance verified 2026-02-21 and checked 2026-08-14"
    },
    {
      "id": "fr_service_public_annual_accounts_current",
      "authority": "Entreprendre Service Public / Ministry of Justice",
      "title": "Dépôt des comptes annuels d'une société",
      "url": "https://entreprendre.service-public.gouv.fr/vosdroits/F31214",
