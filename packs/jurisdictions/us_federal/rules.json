  "rules": [
    {
      "id": "us.federal.c_corp.classification.evidence",
      "summary": "先确认主体是境内 C corporation 或已选择按 C corporation 纳税并保留分类证据；S corporation、partnership 和未确认分类的 LLC 不进入本 Pack 的 Form 1120 工作流。",
      "effective_from": "2026-04-13",
      "automation_level": "evidence",
      "human_review_required": true,
      "source_ids": ["us_irs_topic_407_entity_classification"]
    },
    {
      "id": "us.federal.ein.registration.evidence",
      "summary": "保存 IRS 分配的 EIN 确认证据、法定名称和 responsible party 复核结果；系统不代为申请或变更 EIN。",
      "effective_from": "2026-08-13",
      "automation_level": "evidence",
      "human_review_required": true,
      "source_ids": ["us_irs_ein_current"]
    },
    {
      "id": "us.federal.form_1120.calendar.2025",
      "summary": "Form 1120 一般在税年结束后第4个月第15日到期，但 6 月 30 日财年及周末/法定假日存在专门规则；必须按税年说明和主体税年结束日配置候选日期。",
      "effective_from": "2025-01-01",
      "automation_level": "calendar",
      "human_review_required": true,
      "review_gate": "tax_advisor_review",
      "schedule": {
        "kind": "manual_configuration",
        "required_fields": [
          "confirmed_form_1120_filer",
