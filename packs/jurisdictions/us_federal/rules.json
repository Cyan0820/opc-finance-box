          "approved_candidate_due_date"
        ],
        "registration_any": ["us_c_corporation", "c_corporation", "form_1120_filer"]
      },
      "source_ids": ["us_irs_form_1120_instructions_2025"]
    },
    {
      "id": "us.federal.corporate_estimated_tax.calendar",
      "summary": "普通 corporation 预计税额达到官方门槛时通常需要分期缴纳 estimated tax；适用性、每期金额、EFTPS 和第4/6/9/12个月第15日及顺延必须由当前年度资料确认。",
      "effective_from": "2024-01-01",
      "automation_level": "calendar",
      "human_review_required": true,
      "review_gate": "tax_advisor_review",
